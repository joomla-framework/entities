{
  "name": "joomla/entities",
  "type": "joomla-package",
  "description": "Joomla Entity Project",
  "keywords": ["joomla", "framework", "entity"],
  "homepage": "https://github.com/joomla-framework/entities",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.3.0",
    "ext-json": "*",
    "joomla/database": "dev-4.x-dev",
    "joomla/string": "dev-4.x-dev",
    "joomla/event": "dev-4.x-dev",
    "doctrine/inflector": "^2.0.10",
    "nesbot/carbon": "^3.10.1"
  },
  "require-dev": {
    "joomla/test": "dev-4.x-dev",
    "phpunit/phpunit": "^12.2.6",
    "squizlabs/php_codesniffer": "^3.7.2",
    "phpstan/phpstan": "^2.1.17",
    "phpstan/phpstan-deprecation-rules": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "Joomla\\Entity\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Joomla\\Entity\\Tests\\": "Tests/"
    }
  },
  "minimum-stability": "dev",
  "extra": {
    "branch-alias": {
      "dev-2.0-dev": "2.0-dev",
      "dev-3.x-dev": "3.0-dev",
      "dev-4.x-dev": "4.0-dev"
    }
  }
}
